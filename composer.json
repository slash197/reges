{
    "name": "slash197/reges",
    "description": "PHP client for the REGES Online API (Romanian general register of employees, Inspectia Muncii)",
    "type": "library",
    "license": "MIT",
    "keywords": ["reges", "reges-online", "revisal", "inspectia-muncii", "romania", "payroll", "hr"],
    "homepage": "https://github.com/slash197/reges",
    "authors": [
        {
            "name": "Levi Szocs",
            "email": "levi.szocs@codescape.ro"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "nyholm/psr7": "^1.8",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Any PSR-18 HTTP client works; Guzzle is the one this package is tested with"
    },
    "autoload": {
        "psr-4": {
            "Slash197\\Reges\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slash197\\Reges\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
