# Credentials for the REGES test environment (make smoke, make run). Copy to .env, which is not committed.
# The client id and secret for the test environment are published in the REGES integration docs.
REGES_CLIENT_ID=reges-api
REGES_CLIENT_SECRET=
# API key pair from the REGES employer application: Setari -> Acces -> Chei API
REGES_USERNAME=
REGES_PASSWORD=
# Optional: name reported as the message author, and request logging to stderr
#REGES_USER=
#REGES_DEBUG=1
